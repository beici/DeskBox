<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.WidgetContents.PomodoroWidgetContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PomodoroFocusBrush" Color="#F47B67" />
                    <SolidColorBrush x:Key="PomodoroFocusStrongBrush" Color="#DB5549" />
                    <SolidColorBrush x:Key="PomodoroFocusSoftBrush" Color="#42F5A99D" />
                    <SolidColorBrush x:Key="PomodoroShortBreakBrush" Color="#70AE8B" />
                    <SolidColorBrush x:Key="PomodoroShortBreakStrongBrush" Color="#4D8D6C" />
                    <SolidColorBrush x:Key="PomodoroShortBreakSoftBrush" Color="#3D70AE8B" />
                    <SolidColorBrush x:Key="PomodoroLongBreakBrush" Color="#5796A6" />
                    <SolidColorBrush x:Key="PomodoroLongBreakStrongBrush" Color="#397787" />
                    <SolidColorBrush x:Key="PomodoroLongBreakSoftBrush" Color="#3D5796A6" />
                    <SolidColorBrush x:Key="PomodoroDialTextBrush" Color="#253247" />
                    <SolidColorBrush x:Key="PomodoroPendingDotBrush" Color="#2E524743" />
                    <SolidColorBrush x:Key="PomodoroAccentTextBrush" Color="#FF351714" />
                    <SolidColorBrush x:Key="PomodoroDialSurfaceBrush" Color="#F1F5FA" />
                    <SolidColorBrush x:Key="PomodoroTrackBrush" Color="#28465974" />
                    <SolidColorBrush x:Key="PomodoroDialBorderBrush" Color="#1E465974" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PomodoroFocusBrush" Color="#FF8978" />
                    <SolidColorBrush x:Key="PomodoroFocusStrongBrush" Color="#E7685B" />
                    <SolidColorBrush x:Key="PomodoroFocusSoftBrush" Color="#45FF8978" />
                    <SolidColorBrush x:Key="PomodoroShortBreakBrush" Color="#79C49C" />
                    <SolidColorBrush x:Key="PomodoroShortBreakStrongBrush" Color="#54A27C" />
                    <SolidColorBrush x:Key="PomodoroShortBreakSoftBrush" Color="#4279C49C" />
                    <SolidColorBrush x:Key="PomodoroLongBreakBrush" Color="#67B2C2" />
                    <SolidColorBrush x:Key="PomodoroLongBreakStrongBrush" Color="#438D9D" />
                    <SolidColorBrush x:Key="PomodoroLongBreakSoftBrush" Color="#4267B2C2" />
                    <SolidColorBrush x:Key="PomodoroDialTextBrush" Color="#F4F7FC" />
                    <SolidColorBrush x:Key="PomodoroPendingDotBrush" Color="#38FFFFFF" />
                    <SolidColorBrush x:Key="PomodoroAccentTextBrush" Color="#FF171312" />
                    <SolidColorBrush x:Key="PomodoroDialSurfaceBrush" Color="#253247" />
                    <SolidColorBrush x:Key="PomodoroTrackBrush" Color="#34FFFFFF" />
                    <SolidColorBrush x:Key="PomodoroDialBorderBrush" Color="#24FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="PomodoroFocusBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PomodoroFocusStrongBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PomodoroFocusSoftBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="PomodoroShortBreakBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PomodoroShortBreakStrongBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PomodoroShortBreakSoftBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="PomodoroLongBreakBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PomodoroLongBreakStrongBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PomodoroLongBreakSoftBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="PomodoroDialTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PomodoroPendingDotBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="PomodoroAccentTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="PomodoroDialSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PomodoroTrackBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="PomodoroDialBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style
                x:Key="PomodoroSideButtonStyle"
                BasedOn="{StaticResource SubtleButtonStyle}"
                TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="20" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        x:Name="RootGrid"
        Padding="16,10,16,14"
        SizeChanged="RootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="DialHost" Grid.Row="0" Width="190" Height="190"
              Margin="0,4,0,8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Viewbox IsHitTestVisible="False" Stretch="Uniform">
                <Grid Width="190" Height="190">
                    <Ellipse x:Name="DialSurface" Margin="13"
                             Fill="{ThemeResource PomodoroDialSurfaceBrush}"
                             Stroke="{ThemeResource PomodoroDialBorderBrush}" StrokeThickness="0.75" />
                    <Ellipse x:Name="ProgressTrackRing" Margin="5" Fill="Transparent"
                             Stroke="{ThemeResource PomodoroTrackBrush}" StrokeThickness="3" />
                    <Path x:Name="ProgressArc" HorizontalAlignment="Left" VerticalAlignment="Top"
                          Stroke="{ThemeResource PomodoroFocusBrush}"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeThickness="3" />
                    <StackPanel x:Name="CountdownPanel" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="8">
                        <Grid Width="22" Height="22" HorizontalAlignment="Center">
                            <Ellipse x:Name="PhaseEmblem" Width="16" Height="16" Margin="0,4,0,0"
                                     Fill="{ThemeResource PomodoroFocusBrush}" />
                            <Path Data="M11,6 C7,6 5,3 6,2 C9,2 11,3 11,6 M11,6 C14,6 16,3 15,2 C12,2 11,3 11,6"
                                  Stroke="{ThemeResource PomodoroDialTextBrush}" StrokeThickness="1.1"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.65" />
                        </Grid>
                        <TextBlock x:Name="CountdownTextBlock" MinWidth="126"
                                   HorizontalAlignment="Center" Foreground="{ThemeResource PomodoroDialTextBrush}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="42"
                                   FontWeight="SemiLight" Typography.NumeralAlignment="Tabular"
                                   CharacterSpacing="-20" TextAlignment="Center" />
                        <TextBlock x:Name="PhaseTextBlock" HorizontalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"
                                   Foreground="{ThemeResource PomodoroDialTextBrush}" FontSize="11"
                                   FontWeight="Medium" Opacity="0.72" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Grid>

        <StackPanel
            x:Name="RoundPanel"
            Grid.Row="1"
            Margin="0,0,0,10"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="9">
            <StackPanel
                x:Name="RoundDotsPanel"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="5" />
            <TextBlock
                x:Name="RoundSummaryTextBlock"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid
            x:Name="ActionBar"
            Grid.Row="2"
            HorizontalAlignment="Center"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="ResetButton"
                Click="ResetButton_Click"
                Style="{StaticResource PomodoroSideButtonStyle}">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>

            <Button
                x:Name="PrimaryActionButton"
                Grid.Column="1"
                Width="112"
                Height="44"
                MinWidth="96"
                Padding="14,0"
                Click="PrimaryActionButton_Click"
                CornerRadius="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="PrimaryActionIcon" FontSize="13" />
                    <TextBlock
                        x:Name="PrimaryActionTextBlock"
                        MaxLines="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <Button
                x:Name="SkipButton"
                Grid.Column="2"
                Click="SkipButton_Click"
                Style="{StaticResource PomodoroSideButtonStyle}">
                <FontIcon FontSize="14" Glyph="&#xE893;" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
