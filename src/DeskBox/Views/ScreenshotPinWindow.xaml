<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeskBox.Views.ScreenshotPinWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DeskBox">
    <!-- A pinned screenshot: this grid is the whole borderless window, so the
         entire surface is a drag target and a context-menu target. It stays
         transparent because window alpha (Ctrl+wheel) is applied to the layered
         HWND, never to the XAML content — that way the desktop shows through
         instead of a dimmed copy of the content. -->
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        DoubleTapped="RootGrid_DoubleTapped"
        PointerCaptureLost="RootGrid_PointerCaptureLost"
        PointerMoved="RootGrid_PointerMoved"
        PointerPressed="RootGrid_PointerPressed"
        PointerReleased="RootGrid_PointerReleased"
        PointerWheelChanged="RootGrid_PointerWheelChanged">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Key="Escape"
                Invoked="EscapeAccelerator_Invoked" />
            <!-- 1/2 rotate a quarter turn, 3/4 mirror, the Snipaste F3 key map. -->
            <KeyboardAccelerator
                Key="Number1"
                Invoked="RotateClockwiseAccelerator_Invoked" />
            <KeyboardAccelerator
                Key="Number2"
                Invoked="RotateCounterClockwiseAccelerator_Invoked" />
            <KeyboardAccelerator
                Key="Number3"
                Invoked="FlipHorizontalAccelerator_Invoked" />
            <KeyboardAccelerator
                Key="Number4"
                Invoked="FlipVerticalAccelerator_Invoked" />
            <KeyboardAccelerator
                Key="C"
                Modifiers="Control"
                Invoked="CopyAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem
                    x:Name="CopyMenuItem"
                    Click="CopyMenuItem_Click" />
                <MenuFlyoutItem
                    x:Name="SaveAsMenuItem"
                    Click="SaveAsMenuItem_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    x:Name="CloseMenuItem"
                    Click="CloseMenuItem_Click" />
            </MenuFlyout>
        </Grid.ContextFlyout>
        <!-- The image keeps its *unrotated* layout size (set from code) and is
             rotated about its own centre, so a quarter turn fills the swapped
             window box exactly. Rotate is listed before the mirror scale
             because a TransformGroup applies its children in order: the mirror
             must act on the already-rotated visual, which is what "flip what I
             see" means. -->
        <Image
            x:Name="PinImage"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            RenderTransformOrigin="0.5,0.5"
            Stretch="Fill">
            <Image.RenderTransform>
                <TransformGroup>
                    <RotateTransform x:Name="PinRotateTransform" />
                    <ScaleTransform x:Name="PinMirrorTransform" />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
        <!-- Hairline frame so a pinned image on a matching background is still
             visible. Never hit-testable: the grid underneath owns every
             pointer gesture. -->
        <Border
            x:Name="PinBorder"
            BorderBrush="#5529B6F6"
            BorderThickness="1"
            IsHitTestVisible="False" />
    </Grid>
</Window>
